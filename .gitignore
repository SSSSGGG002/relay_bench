# Python
__pycache__/
*.pyc
.venv/

# Run outputs and evidence — local to each machine, regenerated every run.
# The server only needs the engine code, not another machine's results.
results/
results-*/
logs/
site/
*.partial.json

# Generated reports (report.py / compare.py / ops.py / greedy.py / final.py
# overwrite these in place, so they churn constantly)
/REPORT*.md
/COMPARE*.md
/OPS*.md
/GREEDY*.md
/FINAL*.md

# Ad-hoc backups
backup-*/
suite/.bak/
*.bak
*.bak-*
*.pre-*

# Never commit credentials
.env
.env.*
*.key

# macOS
.DS_Store

# Empty golden capture (subscription OAuth had expired on 09-25); re-capture before tracking
suite/golden/claude-opus-5-5.json
